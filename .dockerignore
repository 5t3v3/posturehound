# Keep the build context small and free of local/machine state and secrets.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tool state (scan history / credentials) - never bake into the image.
.posturehound/
data/

# Secrets
.env
.env.*
!.env.example

# Tests and dev-only deps aren't needed in the runtime image.
tests/
requirements-dev.txt

# Briefing / report artifacts and scratch (may contain live tenant data).
*.pptx
*.pptx.bak*
presentation-script.md
*-report.*
*-impact-report.*
scratchpad/

# Editor / OS / harness noise
.claude/
.DS_Store
Thumbs.db
node_modules/
