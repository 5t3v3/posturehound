# PostureHound Reader service-principal credentials (v2 Track B live collection).
# Copy to .env and fill in. .env is git-ignored and never persisted to settings.json.
# Either the PH_ARG_* names OR the standard Azure names below work.

PH_ARG_TENANT_ID=00000000-0000-0000-0000-000000000000
PH_ARG_CLIENT_ID=00000000-0000-0000-0000-000000000000
PH_ARG_CLIENT_SECRET=your-client-secret

# Standard Azure names are also accepted:
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# Anthropic API key for AI finding generation (optional - can also be set in the
# UI's Settings page). Read from the environment by the container.
# ANTHROPIC_API_KEY=

# Azure DevOps integration (optional): Personal Access Token used to create work
# items from findings. Scope: Work Items (Read & Write). ENV-ONLY - it is never
# written to settings.json or returned by any API. The rest of the ADO config
# (org URL, project, area, tags, default assignee/Epic) is set in the UI Settings.
# PH_ADO_PAT=your-azure-devops-pat

# ── Authentication (V2) ──────────────────────────────────────────────────────
# The web UI requires sign-in. On first boot a default account is seeded:
#   username: admin   password: posturehound   (you are prompted to change it)
# Override the seeded password at first boot (before auth.json is created):
# PH_ADMIN_PASSWORD=change-me-on-deploy
#
# JWT signing secret for session tokens. If unset, a random secret is generated
# once and persisted in ~/.posturehound/auth.json. Set it explicitly to keep
# sessions valid across a data-dir reset, or to share one secret across replicas.
# PH_JWT_SECRET=a-long-random-string
#
# Session lifetime in hours (default 12).
# PH_AUTH_TTL_HOURS=12
#
# Disable auth enforcement entirely (TEST/DEV ONLY - never in production).
# PH_AUTH_DISABLED=1
